# Dynamic theme colors
#config-file = ?"~/.config/omarchy/current/theme/ghostty.conf"

theme = Builtin Pastel Dark

# Font
font-family = "CaskaydiaMono Nerd Font"
font-style = Regular
font-size = 14

# Window
window-padding-x = 14
window-padding-y = 14
confirm-close-surface=false
resize-overlay = never

# Cursor stlying
cursor-style = "block"
cursor-style-blink = true
shell-integration = detect
shell-integration-features = no-cursor, title, sudo

# Keyboard bindings
keybind = f11=toggle_fullscreen
# Unbind the built-in default so Ctrl+Enter passes through to the app
# (Claude Code uses it; it was toggling Ghostty fullscreen instead)
keybind = ctrl+enter=unbind


copy-on-select = clipboard
app-notifications = no-clipboard-copy

