{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 32,
  "modules-left": [
    "niri/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    // "custom/sysinfo",
    "mpd",
    "group/tray-expander",
    "custom/bluelight",
    "pulseaudio",
    "bluetooth",
    "custom/btbat#audio",
    "custom/btbat#input",
    "network",
    "custom/netinfo",
    "cpu",
    "battery",
    "custom/power"
  ],
  "niri/workspaces": {
    "on-click": "activate",
    "on-click-right": "niri msg action toggle-overview",
    "on-click-middle": "walker --height 980 --width 980 --provider niriactions",
    "format": ""
  },
  "clock": {
    "format": "{:%b %d %H:%M}",
    "format-alt": "{:%a, %b %d %Y %H:%M}",
    "tooltip": true,
    "tooltip-format": "<tt>{calendar}</tt>",
    "timezones": [
      ""
    ],
    "on-click-right": "xdg-open https://calendar.google.com",
    "on-click-middle": "dfr-tz-set --geo",
    "on-click-backward": "xdg-open https://www.worldtimebuddy.com",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "days": "<span color='#ecc6d9'><b>{}</b></span>",
        "weeks": "<span color='#99ffdd'><b>W{:%V}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
      }
    }
  },
  "mpd": {
    "format": "{stateIcon} {uri}",
    "format-stopped": "",
    "tooltip-format": "{title} by {artist} (Album: {album})",
    "state-icons": {
      "playing": "\u25b6",
      "paused": "\u23f8"
    },
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl stop",
    "on-click-middle": "dfr-launch-or-focus-tui rmpc",
    "on-click-backward": "playerctl position 10-",
    "on-click-forward": "playerctl position 10+",
    "on-scroll-up": "playerctl previous",
    "on-scroll-down": "playerctl next"
  },
  "group/tray-expander": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 300,
      "children-class": "tray-group-item",
      "start-expanded": true,
      "click-to-reveal": true
    },
    "modules": [
      "custom/expand-icon",
      "tray"
    ]
  },
  "custom/expand-icon": {
    "format": "\uf104",
    "on-click": "xdg-open https://archlinux.org/packages/",
    "on-click-right": "xdg-open https://aur.archlinux.org/packages",
    "on-click-middle": "xdg-open https://www.nerdfonts.com/cheat-sheet",
    "tooltip": false
  },
  "pulseaudio": {
    "format": "{icon}",
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "tooltip-format": "Playback volume: {volume}%",
    "scroll-step": 5,
    "format-muted": "\udb81\udf5f",
    "format-icons": {
      "default": [
        "\uf026",
        "\uf027",
        "\uf028"
      ]
    }
  },
  "tray": {
    "icon-size": 16,
    "spacing": 12
  },
  "bluetooth": {
    "format": "\uf294",
    "format-disabled": "\udb80\udcb2",
    "format-connected": "\uf294",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "sh -c 'dfr-launch-or-focus-tui bluetui || notify-send \"Bluetooth adapter not found\"'"
  },
  // split so each hover tooltip only lists its own devices
  "custom/btbat#audio": {
    "format": "{text}",
    "exec": "$HOME/.config/waybar/scripts/btbat.sh audio",
    "interval": 30,
    "tooltip": true,
    "on-click": "dfr-launch-or-focus-tui bluetui"
  },
  "custom/btbat#input": {
    "format": "{text}",
    "exec": "$HOME/.config/waybar/scripts/btbat.sh other",
    "interval": 30,
    "tooltip": true,
    "on-click": "dfr-launch-or-focus-tui bluetui"
  },
  "network": {
    "format-icons": [
      "\udb82\udd2f",
      "\udb82\udd1f",
      "\udb82\udd22",
      "\udb82\udd25",
      "\udb82\udd28"
    ],
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "\udb80\udc02",
    "format-disconnected": "\udb81\uddaa",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n\u21e3{bandwidthDownBytes}  \u21e1{bandwidthUpBytes}\n\n{ipaddr}",
    "tooltip-format-ethernet": "\u21e3{bandwidthDownBytes}  \u21e1{bandwidthUpBytes}\n\n{ipaddr}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 10,
    "on-click": "sh -c 'dfr-launch-or-focus-tui impala || notify-send \"Wi-Fi adapter not found\"'",
    "on-click-right": "xdg-open https://speedtest.net",
    "on-click-middle": "xdg-open http://www.asusrouter.com/Main_Login.asp",
    "on-click-forward": "sh -c 'notify-send \"$(myip --public) copied to clipboard\"'",
    "on-click-backward": "sh -c 'notify-send \"$(myip --local) copied to clipboard\"'"
  },
  "cpu": {
    "interval": 5,
    "format": "\udb80\udf5b",
    "on-click": "dfr-launch-or-focus-tui monitor",
    "on-click-right": "dfr-launch-or-focus-tui btop",
    "on-click-middle": "sh -c 'specs && notify-send \"Specs copied to clipboard\"'"
  },
  "battery": {
    "format": "{capacity}% {icon}",
    "format-discharging": "{icon}",
    "format-charging": "{icon}",
    "format-plugged": "\uf1e6",
    "format-icons": {
      "charging": [
        "\udb82\udc9c",
        "\udb80\udc86",
        "\udb80\udc87",
        "\udb80\udc88",
        "\udb82\udc9d",
        "\udb80\udc89",
        "\udb82\udc9e",
        "\udb80\udc8a",
        "\udb80\udc8b",
        "\udb80\udc85"
      ],
      "default": [
        "\udb80\udc7a",
        "\udb80\udc7b",
        "\udb80\udc7c",
        "\udb80\udc7d",
        "\udb80\udc7e",
        "\udb80\udc7f",
        "\udb80\udc80",
        "\udb80\udc81",
        "\udb80\udc82",
        "\udb80\udc79"
      ]
    },
    "format-full": "\udb80\udc85",
    "tooltip-format-discharging": "{power:>1.0f}W\u2193 {capacity}%",
    "tooltip-format-charging": "{power:>1.0f}W\u2191 {capacity}%",
    "interval": 5,
    "states": {
      "warning": 20,
      "critical": 10
    }
  },
  "custom/power": {
    "format": "\u23fb",
    "on-click": "$HOME/.config/waybar/power-menu.sh",
    "tooltip": true,
    "tooltip-format": "Power menu"
  },
  "custom/help": {
    "format": "\uf03a ",
    "on-click": "foot -a niri-keybinds -W 96x40 -f 'CaskaydiaMono Nerd Font:size=12' -e sh -c 'i=0; while [ \"$(stty size 2>/dev/null | cut -d\" \" -f1)\" != \"40\" ] && [ $i -lt 100 ]; do sleep 0.05; i=$((i+1)); done; python3 ~/.config/niri/keybinds-help.py | LESSKEYIN=$HOME/.config/niri/lesskeys less -R -X'",
    "tooltip": false
  },
  "custom/netinfo": {
    "format": "{text}",
    "exec": "$HOME/.config/waybar/scripts/netinfo.sh",
    "interval": 1
  },
  "custom/sysinfo": {
    "format": "{text}",
    "exec": "$HOME/.config/waybar/scripts/sysinfo.sh",
    "interval": 10,
    "on-click": "dfr-launch-or-focus-tui monitor",
    "on-click-right": "dfr-launch-or-focus-tui btop"
  },
  "custom/bluelight": {
    "format": "{text}",
    "exec": "$HOME/.config/waybar/scripts/bluelight.sh",
    "interval": 5,
    "on-click": "$HOME/.config/waybar/scripts/bluelight.sh toggle"
  }
}